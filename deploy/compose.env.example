# Copy to .env.docker on the deployment host. No credentials belong here.
SRE_IMAGE=device-performance-sre:local
SRE_BIND_ADDRESS=127.0.0.1
SRE_PUBLISHED_PORT=8765
MST_BASE_URL=https://api.tms.uat.pinelabs.com
SRE_MONITOR_CONFIG=./monitor.json
SRE_MST_SECRET_DIR=./secrets/mst
SRE_MCP_SECRET_DIR=./secrets/mcp
# Add the exact HTTPS reverse-proxy hostname, for example:
# SRE_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,device-sre.internal.example:*
SRE_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
