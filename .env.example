# Store a token in a chmod-600 file outside source control. It is re-read for
# each request so an existing token-refresh process can atomically replace it.
# .env contains the path; configure-token saves the actual approved token there.
MST_TOKEN_FILE=data/mst-token
# Alternatively set MST_BEARER_TOKEN in the process environment.
MST_BASE_URL=https://api.tms.uat.pinelabs.com
SRE_CONFIG=monitor.json
SRE_DATA_DIR=data
# Required only for HTTP MCP. Use a DIFFERENT secret from the MST credential.
SRE_MCP_TOKEN_FILE=data/connector-token
SRE_HOST=127.0.0.1
SRE_PORT=8765
# Add the exact internal reverse-proxy hostname when deploying remotely.
SRE_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

